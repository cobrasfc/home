---
import { SITE } from '../site.config';
import { withBase } from '../utils/withBase';
---

<footer class="bg-cobra-blue">
	<div class="container-page grid gap-6 py-10 md:grid-cols-2 md:items-start">
		<div class="space-y-3">
			<div class="flex items-center gap-3">
				<img src={withBase('/assets/logo-shield.svg')} width="36" height="36" alt="Metford Cobras club logo" />
				<div>
					<div class="text-sm font-medium text-white">{SITE.name}</div>
					<div class="text-xs text-white/60">Built for players, volunteers, and sponsors.</div>
				</div>
			</div>
			<div class="text-sm text-white/70">
				<span class="font-medium text-white">Get involved:</span> Play football, lend a hand, or back local sport.
			</div>
		</div>

		<nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm" aria-label="Footer">
			<a class="text-white/70 hover:text-cobra-yellow transition-colors" href={SITE.facebookUrl} target="_blank" rel="noreferrer">
				Facebook
			</a>
			<a class="text-white/70 hover:text-cobra-yellow transition-colors" href={withBase('/contact-us')}>Contact Us</a>
			<a class="text-white/70 hover:text-cobra-yellow transition-colors" href={withBase('/committee')}>Committee</a>
		</nav>
	</div>
	<div class="border-t border-white/10 py-4">
		<div class="container-page text-xs text-white/40">
			© {new Date().getFullYear()} {SITE.name}
		</div>
	</div>
</footer>

---
// One scenario's pitch use by wave: each square is a pitch, tinted and tagged by the competition using it.
import { makeView, range, type PlanData, type Scenario } from './view';

interface Props {
	data: PlanData;
	scenario: Scenario;
	heading?: boolean;
}
const { data, scenario: s, heading = true } = Astro.props;
const v = makeView(data);
---

<article class="ad-card">
	{heading && <h3 class="ad-h3">{s.name} <span class="ad-muted">· {s.title}</span></h3>}
	{s.fieldNote && <p class="ad-note ad-note--card">{s.fieldNote}</p>}
	{s.nights.map((n: any) => (
		<div class="ad-night">
			<h4 class="ad-h4">{n.night}{n.varies && <span class="ad-h4__week"> · week {n.shownWeek} shown · {n.shownWeeks} of {data.weeks} weeks have the same games per wave</span>}</h4>
			{n.waves.map((w: any) => (
				<div class="ad-wave">
					<p class="ad-wave__time"><strong>Wave {w.wave}</strong><br />{w.start}–{w.end}</p>
					<ol class="ad-strip" style={`--cells:${v.cells(s, w).length}`} aria-label={`${s.name}, ${n.night} wave ${w.wave}: ${w.allocations.map((a: any) => `${v.compName(a.comp)} ${range(a.gamesMin, a.gamesMax)} games`).join(', ')}; ${v.freeText(s, w)}`}>
						{v.cells(s, w).map((c) => (
							<li class={`ad-cell${c.use ? '' : ' is-free'}${c.id.startsWith('minis') ? ' is-mini' : ''}`} style={c.use ? `--plan:${c.use.colour}` : undefined} title={v.cellTitle(c.title, c.use)}>
								<span class="ad-cell__num">{c.label}</span>
								<span class="ad-cell__tag">{c.use ? c.use.tag : 'free'}</span>
							</li>
						))}
					</ol>
					<p class="ad-wave__free">{v.freeText(s, w)}</p>
				</div>
			))}
		</div>
	))}
</article>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';
---

<BaseLayout title="Club Sponsorship &#8212; Metford Cobras FC" description="Express your interest in becoming the Metford Cobras FC Club Sponsor for the 2026/27 season.">
	<section class="container-page py-10 md:py-14 max-w-2xl">
		<p class="kicker">Club Sponsorship</p>
		<h1 class="page-title">Our flagship sponsorship</h1>
		<p class="mt-4 text-sm text-slate-700">
			Club Sponsorship is the most prominent partnership we offer. Your business gets prime position across every promotion we run &#8212; jerseys, signage, social media, and more.
		</p>

		<div class="mt-6 rounded-2xl bg-cobra-blue p-5">
			<h2 class="text-base font-semibold text-cobra-yellow">One sponsor. One season.</h2>
			<p class="mt-2 text-sm text-white/80">
				We only take on one Club Sponsor per season. This means your business isn&#8217;t sharing the spotlight with anyone &#8212; you&#8217;re the name the Cobras community associates with the club all year.
			</p>
		</div>

		<div class="mt-6 card bg-cobra-blue/5 ring-0">
			<h2 class="text-sm font-semibold text-slate-900">What Club Sponsorship includes</h2>
			<ul class="mt-3 space-y-2 text-sm text-slate-700">
				<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span>Your logo on the <strong class="text-slate-900">back of all team jerseys</strong> &#8212; junior and senior teams.</span></li>
				<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span><strong class="text-slate-900">Prime placement</strong> across all social media posts, email newsletters, and signage throughout the season.</span></li>
				<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span>A <strong class="text-slate-900">thank you video</strong> posted across our socials.</span></li>
				<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span>A <strong class="text-slate-900">senior team jersey</strong> with your logo on the back and a thank you letter for display at your business.</span></li>
				<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span>All Digital and Field Sponsorship benefits included.</span></li>
			</ul>
		</div>

		<div class="mt-6 rounded-2xl bg-cobra-yellow p-5">
			<h2 class="text-base font-semibold text-cobra-blue">Expressions of interest close November 2026</h2>
			<p class="mt-2 text-sm text-cobra-blue/80">
				We accept expressions of interest until <strong>November 2026</strong>, after which the committee will review all applications and contact businesses directly. Submitting an expression of interest does not guarantee Club Sponsorship.
			</p>
		</div>

		<form
			id="club-sponsor-form"
			class="mt-8 space-y-5"
			novalidate
		>
			<input type="hidden" name="_subject" value="Club Sponsor Expression of Interest — Metford Cobras FC" />

			<div>
				<label class="block text-sm font-medium text-slate-900" for="business-name">
					Business name <span class="text-red-500" aria-hidden="true">*</span>
				</label>
				<input
					class="mt-1 w-full rounded-lg border border-black/10 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobra-blue"
					type="text"
					id="business-name"
					name="business_name"
					required
					autocomplete="organization"
				/>
			</div>

			<div>
				<label class="block text-sm font-medium text-slate-900" for="contact-name">
					Your name <span class="text-red-500" aria-hidden="true">*</span>
				</label>
				<input
					class="mt-1 w-full rounded-lg border border-black/10 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobra-blue"
					type="text"
					id="contact-name"
					name="contact_name"
					required
					autocomplete="name"
				/>
			</div>

			<div>
				<label class="block text-sm font-medium text-slate-900" for="contact-email">
					Email address <span class="text-red-500" aria-hidden="true">*</span>
				</label>
				<input
					class="mt-1 w-full rounded-lg border border-black/10 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobra-blue"
					type="email"
					id="contact-email"
					name="contact_email"
					required
					autocomplete="email"
				/>
			</div>

			<div>
				<label class="block text-sm font-medium text-slate-900" for="contact-phone">
					Phone number
				</label>
				<input
					class="mt-1 w-full rounded-lg border border-black/10 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobra-blue"
					type="tel"
					id="contact-phone"
					name="contact_phone"
					autocomplete="tel"
				/>
			</div>

			<div>
				<label class="block text-sm font-medium text-slate-900" for="message">
					Anything else you&#8217;d like us to know? <span class="font-normal text-slate-500">(optional)</span>
				</label>
				<textarea
					class="mt-1 w-full rounded-lg border border-black/10 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobra-blue"
					id="message"
					name="message"
					rows="3"
				></textarea>
			</div>

			<div id="form-error" class="rounded-xl bg-red-50 p-4 text-sm text-red-700 ring-1 ring-red-200" style="display:none">
				Something went wrong. Please try again or contact us at <a class="underline" href={"mailto:" + SITE.contact.email}>{SITE.contact.email}</a>.
			</div>

			<button type="submit" id="submit-btn" class="btn-primary w-full justify-center">
				Submit expression of interest &#8594;
			</button>
		</form>

		<div id="success-msg" class="mt-8 rounded-2xl bg-cobra-yellow p-6" style="display:none">
			<h2 class="text-lg font-semibold text-cobra-blue">We&#8217;ve received your expression of interest!</h2>
			<p class="mt-2 text-sm text-cobra-blue/80">
				Thank you for your interest in becoming our Club Sponsor. The committee will be in touch before the end of November 2026 to let you know the outcome.
			</p>
			<a class="mt-4 btn-primary inline-flex" href="/sponsorship">Back to sponsorship &#8594;</a>
		</div>

		<p class="mt-6 text-center text-sm text-slate-500">
			Questions? <a class="text-cobra-blue hover:underline" href={"mailto:" + SITE.contact.email}>{SITE.contact.email}</a>
		</p>
	</section>
</BaseLayout>

<script is:inline>
(function () {
	var form = document.getElementById('club-sponsor-form');
	var btn = document.getElementById('submit-btn');
	var errorBox = document.getElementById('form-error');
	var successMsg = document.getElementById('success-msg');

	if (!form) return;

	form.addEventListener('submit', function (e) {
		e.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		btn.disabled = true;
		btn.textContent = 'Submitting...';
		errorBox.style.display = 'none';

		var data = new FormData(form);

		fetch('https://formspree.io/f/mnjynorn', {
			method: 'POST',
			body: data,
			headers: { 'Accept': 'application/json' }
		}).then(function (res) {
			if (res.ok) {
				form.style.display = 'none';
				successMsg.style.display = 'block';
			} else {
				errorBox.style.display = 'block';
				btn.disabled = false;
				btn.textContent = 'Submit expression of interest →';
			}
		}).catch(function () {
			errorBox.style.display = 'block';
			btn.disabled = false;
			btn.textContent = 'Submit expression of interest →';
		});
	});
})();
</script>

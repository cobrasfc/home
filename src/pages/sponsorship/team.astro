---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/withBase';

interface Team {
	id: string;
	name: string;
	price: string;
	currentSponsor: string;
	currentSponsorLogo?: string;
	available: boolean;
	nextSponsor?: string;
}

interface Group {
	label: string;
	gridCols: string;
	teams: Team[];
}

const groups: Group[] = [
	{
		label: 'Competition Age',
		gridCols: 'sm:grid-cols-3',
		teams: [
			{
				id: 'aam',
				name: 'All Age Men',
				price: '$1,000',
				currentSponsor: 'KFC',
				currentSponsorLogo: '/assets/sponsors/kfc logo.png',
				available: false,
				nextSponsor: 'KFC Thornton',
			},
			{
				id: 'aaw',
				name: 'All Age Women',
				price: '$1,000',
				currentSponsor: 'The Windsor Castle',
				currentSponsorLogo: '/assets/sponsors/windsor-logo.png',
				available: false,
				nextSponsor: 'Easts',
			},
			{
				id: 'u12',
				name: 'Under 12/13s',
				price: '$1,000',
				currentSponsor: 'Swirl n Dip',
				currentSponsorLogo: '/assets/sponsors/swirl.png',
				available: true,
			},
		],
	},
	{
		label: 'Youth',
		gridCols: 'sm:grid-cols-2',
		teams: [
			{
				id: 'u10',
				name: 'Under 10/11s',
				price: '$800',
				currentSponsor: 'Swirl n Dip',
				currentSponsorLogo: '/assets/sponsors/swirl.png',
				available: true,
			},
		],
	},
	{
		label: 'Miniroos',
		gridCols: 'sm:grid-cols-2 lg:grid-cols-4',
		teams: [
			{
				id: 'u6',
				name: 'Under 6’s',
				price: '$500',
				currentSponsor: 'Swirl n Dip',
				currentSponsorLogo: '/assets/sponsors/swirl.png',
				available: false,
				nextSponsor: 'Swirl n Dip',
			},
			{
				id: 'u7',
				name: 'Under 7’s',
				price: '$500',
				currentSponsor: 'Swirl n Dip',
				currentSponsorLogo: '/assets/sponsors/swirl.png',
				available: false,
				nextSponsor: 'Swirl n Dip',
			},
			{
				id: 'u8',
				name: 'Under 8’s',
				price: '$500',
				currentSponsor: 'Swirl n Dip',
				currentSponsorLogo: '/assets/sponsors/swirl.png',
				available: false,
				nextSponsor: 'Swirl n Dip',
			},
			{
				id: 'u9',
				name: 'Under 9’s',
				price: '$500',
				currentSponsor: 'Swirl n Dip',
				currentSponsorLogo: '/assets/sponsors/swirl.png',
				available: false,
				nextSponsor: 'Swirl n Dip',
			},
		],
	},
];
---

<BaseLayout title="Team Sponsorship &#8212; Metford Cobras FC" description="Sponsor a Metford Cobras FC team for the 2026/27 season. Choose from junior, youth, and senior teams.">
	<section class="container-page py-10 md:py-14">
		<p class="kicker">Team Sponsorship</p>
		<h1 class="page-title">Choose a team to sponsor</h1>
		<p class="mt-4 max-w-2xl text-sm text-slate-700">
			Your logo on the chest of your team&#8217;s jersey &#8212; seen at every training session, game, gala day, and finals. Pick the team that means the most to your business and community.
		</p>

		<div class="mt-10 space-y-10">
			{groups.map((group) => (
				<div>
					<h2 class="text-lg font-semibold text-slate-900">{group.label}</h2>

<div class:list={['mt-4 grid grid-cols-1 gap-4', group.gridCols]}>
						{group.teams.map((team) => (
							<div class:list={['card flex flex-col', !team.available && 'opacity-60']}>
								<div class="flex items-start justify-between gap-3">
									<h3 class="text-base font-semibold text-slate-900">{team.name}</h3>
									<span class="shrink-0 rounded-full bg-cobra-blue/10 px-3 py-1 text-sm font-semibold text-cobra-blue">
										{team.price}
									</span>
								</div>

								<div class="mt-4 space-y-3">
									<div>
										<p class="text-xs font-medium uppercase tracking-wider text-slate-400">26/27 Sponsor</p>
										<div class="mt-1.5">
											{team.available ? (
												<span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">
													Available
												</span>
											) : (
												<span class="text-sm font-medium text-slate-700">{team.nextSponsor} (secured)</span>
											)}
										</div>
									</div>

									<div>
										<p class="text-xs font-medium uppercase tracking-wider text-slate-400">25/26 Sponsor</p>
										<div class="mt-1.5 flex items-center gap-2">
											{team.currentSponsorLogo && (
												<img
													src={withBase(team.currentSponsorLogo)}
													alt={team.currentSponsor}
													class="h-8 w-auto object-contain"
													loading="lazy"
													decoding="async"
												/>
											)}
											<span class="text-sm text-slate-700">{team.currentSponsor}</span>
										</div>
									</div>
								</div>

								<div class="mt-auto pt-5">
									{team.available ? (
										<a class="btn-accent" href={`${withBase('/sponsorship/team/enquire')}?team=${team.id}`}>
											Enquire now &#8594;
										</a>
									) : (
										<span class="inline-flex items-center rounded-lg bg-slate-100 px-3 py-2 text-sm font-medium text-slate-400">
											Not available
										</span>
									)}
								</div>
							</div>
						))}
					</div>
				</div>
			))}
		</div>

		<div class="mt-10 rounded-2xl bg-cobra-blue/5 p-5">
			<h3 class="text-base font-medium text-slate-900">Not sure which team to sponsor?</h3>
			<p class="mt-1 text-sm text-slate-700">Get in touch and we&#8217;ll help you find the best fit for your business.</p>
			<a class="mt-4 btn-primary inline-flex" href="/contact-us">Contact us &#8594;</a>
		</div>
	</section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, SUMMER_DUAL_REGISTRATION } from '../../site.config';
import { withBase } from '../../utils/withBase';

const { fee, paymentLinkUrl } = SUMMER_DUAL_REGISTRATION;
---

<BaseLayout
	title="Summer 6&#8217;s Dual Registration"
	description={`Playing both Men's/Women's and Mixed in Summer 6's? Pay the $${fee} dual registration fee here.`}
>
	<section class="container-page py-10 md:py-14 max-w-2xl">
		<p class="kicker">Summer 6&#8217;s</p>
		<h1 class="page-title">Summer Soccer Dual Registration</h1>
		<p class="mt-4 text-sm text-slate-700">
			Want to play in <strong class="text-slate-900">both</strong> a Men&#8217;s or Women&#8217;s team <strong class="text-slate-900">and</strong>
			a Mixed team this summer? Once you&#8217;ve completed your normal Summer Comp registration through PlayFootball, pay the dual
			registration fee below to lock in your spot in both competitions.
		</p>

		<!-- Paid state (Square redirects back here with ?paid=1) -->
		<div id="paid-msg" class="mt-6 rounded-2xl bg-cobra-yellow p-6" style="display:none">
			<h2 class="text-lg font-semibold text-cobra-blue">Payment received &#8212; thank you!</h2>
			<p class="mt-2 text-sm text-cobra-blue/80">
				You&#8217;re registered to play in both competitions. Square will email you a receipt. If anything looks wrong,
				contact us at <a class="underline" href={'mailto:' + SITE.contact.email}>{SITE.contact.email}</a>.
			</p>
			<a class="mt-4 btn-primary" href={withBase('/play-football/summer')}>Back to Summer Football &#8594;</a>
		</div>

		<div id="pay-section">
			<div class="mt-6 card bg-cobra-blue/5 ring-0">
				<div class="flex items-baseline justify-between gap-4">
					<h2 class="text-sm font-semibold text-slate-900">Dual registration fee</h2>
					<p class="text-2xl font-medium text-cobra-blue">${fee}</p>
				</div>
				<p class="mt-1 text-xs text-slate-500">Paid in addition to your standard Summer Comp registration.</p>
			</div>

			<div class="mt-4 card">
				<h2 class="text-sm font-semibold text-slate-900">Before you pay</h2>
				<ul class="mt-3 space-y-2 text-sm text-slate-700">
					<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span>Make sure you&#8217;ve already registered through PlayFootball (<a class="text-cobra-blue hover:underline" href={withBase('/play-football/summer#register')}>registration links</a>).</span></li>
					<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span>At checkout you&#8217;ll be asked for your <strong class="text-slate-900">name, phone number and email</strong>.</span></li>
					<li class="flex gap-2"><span class="mt-0.5 shrink-0 text-cobra-blue">&#8594;</span><span>You&#8217;ll also be asked for <strong class="text-slate-900">both of your team names</strong> &#8212; your Men&#8217;s/Women&#8217;s team and your Mixed team. Please fill in both so we can match you up.</span></li>
				</ul>
			</div>

			<div class="mt-4 card">
				<h2 class="text-sm font-semibold text-slate-900">Don&#8217;t have a second team? No problem!</h2>
				<p class="mt-2 text-sm text-slate-700">
					You can still dual register as an individual. When you pay, just type
					<strong class="text-slate-900">&#8220;Individual&#8221;</strong> in the team name box for the competition you
					don&#8217;t have a team for &#8212; and we&#8217;ll find a team for you.
				</p>
			</div>

			<div class="mt-6">
				{paymentLinkUrl ? (
					<a class="btn-primary w-full justify-center py-3 text-base" href={paymentLinkUrl} rel="noopener">
						Pay ${fee} securely with Square &#8594;
					</a>
				) : (
					<p class="rounded-xl bg-slate-50 p-4 text-center text-sm text-slate-600 ring-1 ring-black/5">
						Online payment is opening soon. Check back shortly, or contact
						<a class="text-cobra-blue hover:underline" href={'mailto:' + SITE.contact.email}>{SITE.contact.email}</a>.
					</p>
				)}
				<p class="mt-3 text-center text-xs text-slate-500">
					Payments are processed by Square. We never see or store your card details.
				</p>
			</div>

			<div class="mt-6 rounded-xl bg-slate-50 p-4 text-sm text-slate-700 ring-1 ring-black/5">
				<h2 class="font-semibold text-slate-900">Problem paying online, or prefer bank transfer?</h2>
				<p class="mt-1">
					No worries &#8212; contact us directly and we&#8217;ll sort it out with you. Email
					<a class="text-cobra-blue hover:underline" href={'mailto:' + SITE.contact.email}>{SITE.contact.email}</a>
					or call <a class="text-cobra-blue hover:underline" href={'tel:' + SITE.contact.phone.replace(/\s/g, '')}>{SITE.contact.phone}</a>.
				</p>
			</div>
		</div>

		<p class="mt-8 text-center text-sm text-slate-500">
			Questions? Email <a class="text-cobra-blue hover:underline" href={'mailto:' + SITE.contact.email}>{SITE.contact.email}</a>
			&#183; <a class="text-cobra-blue hover:underline" href={withBase('/play-football/summer')}>Back to Summer Football</a>
		</p>
	</section>
</BaseLayout>

<script is:inline>
	(function () {
		if (window.location.search.indexOf('paid=1') === -1) return;
		var pay = document.getElementById('pay-section');
		var msg = document.getElementById('paid-msg');
		if (pay) pay.style.display = 'none';
		if (msg) msg.style.display = 'block';
	})();
</script>

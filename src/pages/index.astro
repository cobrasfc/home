---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/withBase';
---

<BaseLayout title="Home" description="Join Metford Cobras FC — community football for juniors, seniors, and summer competitions.">
	<section class="bg-cobra-blue">
		<!-- Mobile: stacked image above text -->
		<div class="md:hidden">
			<a href={withBase('/play-football/summer-eoi')}>
				<img
					src={withBase('/assets/summer6s/summer6s-hero.png')}
					alt="Metford Cobras Summer 6's"
					class="w-full aspect-video object-cover"
					loading="eager"
					decoding="async"
				/>
			</a>
			<div class="px-4 py-8">
				<div class="w-10 h-1 bg-cobra-yellow rounded mb-4"></div>
				<p class="text-xs font-medium uppercase tracking-wider text-cobra-yellow">Summer Football • Metford</p>
				<h1 class="mt-3 text-4xl font-medium leading-tight text-white">Summer 6&#8217;s is happening!</h1>
				<p class="mt-4 text-base text-white/85">
					Small-sided, fast-paced football at Metford Rec oval. Read the latest update while we finalise the details.
				</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<a class="btn-accent" href={withBase('/play-football/summer-eoi')}>Read the update →</a>
				</div>
			</div>
		</div>

		<!-- Desktop: photo overlay with text shadow -->
		<a href={withBase('/play-football/summer-eoi')} class="relative hidden overflow-hidden md:block">
			<img
				src={withBase('/assets/summer6s/summer6s-hero.png')}
				alt="Metford Cobras Summer 6's"
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
				decoding="async"
			/>
			<div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-cobra-blue/80 via-cobra-blue/50 to-transparent"></div>

			<div class="container-page relative grid items-center gap-6 py-44">
				<div class="w-1/2">
					<div class="w-10 h-1 bg-cobra-yellow rounded mb-4"></div>
					<p class="text-xs font-medium uppercase tracking-wider text-cobra-yellow" style="text-shadow: 0 1px 8px rgba(0,0,0,0.5);">Summer Football • Metford</p>
					<h1 class="mt-3 text-5xl font-medium leading-tight text-white" style="text-shadow: 0 2px 16px rgba(0,0,0,0.55);">Summer 6&#8217;s is happening!</h1>
					<p class="mt-4 text-base text-white/90" style="text-shadow: 0 1px 8px rgba(0,0,0,0.5);">
						Small-sided, fast-paced football at Metford Rec oval. Read the latest update while we finalise the details.
					</p>
					<div class="mt-6 flex flex-wrap gap-3">
					<span class="btn-accent">Read the update →</span>
				</div>
				</div>
			</div>
		</a>
	</section>

	<section>
		<div class="container-page grid gap-4 py-10 md:grid-cols-3">
			<div class="card">
				<p class="kicker">Players</p>
				<h2 class="mt-2 text-lg font-medium text-slate-900">U6's to Over 35's</h2>
				<p class="mt-2 text-sm text-slate-700">Junior, Senior, and Summer football with a supportive club culture.</p>
				<a class="mt-4 inline-block text-sm font-medium text-cobra-blue" href={withBase('/play-football/junior')}>
					Explore playing options →
				</a>
			</div>
			<div class="card">
				<p class="kicker">Volunteers</p>
				<h2 class="mt-2 text-lg font-medium text-slate-900">Make a difference</h2>
				<p class="mt-2 text-sm text-slate-700">Coaching, team management, committee, canteen — every bit helps.</p>
				<a class="mt-4 inline-block text-sm font-medium text-cobra-blue" href={withBase('/committee')}>Become a volunteer →</a>
			</div>
			<div class="card">
				<p class="kicker">Sponsors</p>
				<h2 class="mt-2 text-lg font-medium text-slate-900">Showcase your business</h2>
				<p class="mt-2 text-sm text-slate-700">
					Thousands of players, parents and supporters visit Metford Cobras FC each season.
				</p>
				<a class="mt-4 inline-block text-sm font-medium text-cobra-blue" href={withBase('/sponsorship')}>
					Sponsorship opportunities →
				</a>
			</div>
		</div>
	</section>

	<section class="bg-cobra-blue">
		<div class="container-page py-12">
			<div class="grid gap-8 md:grid-cols-2 md:items-center">
				<div class="space-y-4">
					<p class="text-xs font-medium uppercase tracking-wider text-cobra-yellow">What we stand for</p>
					<h2 class="text-2xl font-medium text-white">A club built on sportsmanship, community, fun, and a love of football.</h2>
					<p class="text-sm text-white/75">
						For over 30 years Metford Cobras FC has been a part of your local community. We believe that our value goes beyond the pitch.<br/>We are committed to fostering a positive environment where players of all ages can develop their skills, build lasting friendships, and contribute to the community. Join us and be part of something special.
					</p>
					<a class="btn-accent" href={withBase('/club/values')}>Read our values</a>
				</div>
				<div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/10">
					<img
						src={withBase('/assets/values_community-hub.png')}
						alt="Community hub illustration"
						class="h-auto w-full"
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/withBase';

interface Tier {
	id: string;
	name: string;
	price: string;
	tagline: string;
	benefits: string[];
	premium?: boolean;
	wide?: boolean;
	jerseyImage?: string;
	jerseyImageAlt?: string;
}

const tiers: Tier[] = [
	{
		id: 'digital',
		name: 'Digital',
		price: '$300',
		tagline: 'Social media and email presence',
		benefits: [
			'Your logo on our social media posts and email newsletters',
			'3 sponsor showcase posts on our Facebook page',
			'Facebook averages approx. 70,000 views per month during the playing season',
		],
	},
	{
		id: 'field',
		name: 'Field',
		price: '$600',
		tagline: 'All Digital benefits, plus ground presence',
		benefits: [
			'All Digital Sponsorship benefits',
			'Your banner or A-Frame displayed at all home games, finals, gala days, and summer 6\u2019s events',
			'Banner or A-Frame to be provided by your business',
		],
	},
	{
		id: 'team',
		name: 'Team',
		price: '$1,000',
		tagline: 'All Digital and Field benefits, plus jersey logo',
		benefits: [
			'All Digital and Field Sponsorship benefits',
			'Your logo on the chest of your nominated team\u2019s jersey',
			'A framed team photo and thank you letter to display at your business',
		],
		jerseyImage: '/assets/sponsors/juniors-your-business-here.png',
		jerseyImageAlt: 'Junior jersey showing sponsor logo placement',
	},
	{
		id: 'club',
		name: 'Club',
		price: '$5,000',
		tagline: 'The ultimate partnership',
		benefits: [
			'All Digital and Field Sponsorship benefits',
			'Your logo on the back of all team jerseys for both junior and senior teams',
			'A thank you video posted on our socials',
			'A senior team jersey with your logo on the back',
			'A thank you letter to display at your business',
		],
		premium: true,
		wide: true,
		jerseyImage: '/assets/sponsors/senior-women-your-business-here.png',
		jerseyImageAlt: 'Senior women\u2019s jersey showing sponsor logo placement',
	},
];
---

<BaseLayout title="Sponsorship" description="Sponsor Metford Cobras FC and connect your business with the local football community across Hunter, Newcastle and Lake Macquarie.">
	<section class="container-page py-10 md:py-14">
		<p class="kicker">Sponsorship</p>
		<h1 class="page-title">Back local sport. Get real local visibility.</h1>
		<p class="mt-4 max-w-2xl text-sm text-slate-700">
			Sponsoring the Cobras supports players and families &#8212; and connects your business with our community across Hunter, Newcastle and Lake Macquarie. Over the year we host thousands of players, parents, and supporters at our winter competition, summer 6&#8217;s competition, and end of year Gala Day.
		</p>

		<div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
			<div class="rounded-xl bg-cobra-blue/5 p-4 text-center">
				<div class="text-2xl font-medium text-cobra-blue">100</div>
				<div class="mt-1 text-xs text-slate-600">Registered members</div>
			</div>
			<div class="rounded-xl bg-cobra-blue/5 p-4 text-center">
				<div class="text-2xl font-medium text-cobra-blue">8</div>
				<div class="mt-1 text-xs text-slate-600">Teams</div>
			</div>
			<div class="rounded-xl bg-cobra-blue/5 p-4 text-center">
				<div class="text-2xl font-medium text-cobra-blue">30+</div>
				<div class="mt-1 text-xs text-slate-600">Years in the community</div>
			</div>
			<div class="rounded-xl bg-cobra-blue/5 p-4 text-center">
				<div class="text-2xl font-medium text-cobra-blue">70k</div>
				<div class="mt-1 text-xs text-slate-600">Monthly Facebook views</div>
			</div>
		</div>

		<div class="mt-6 flex flex-wrap gap-3">
			<a class="btn-primary" href={withBase('/contact-us')}>Enquire about sponsorship</a>
			<a class="btn-secondary" href="#tiers">View sponsorship tiers</a>
			<a class="btn-secondary" href={withBase('/assets/General 2026 Sponsorship Letter.pdf')} target="_blank" rel="noreferrer" download>Download prospectus (PDF)</a>
		</div>

		<div class="mt-10">
			<h2 class="text-xl font-medium text-slate-900">Current sponsors</h2>
			<p class="mt-2 max-w-2xl text-sm text-slate-700">
				We&#8217;re grateful for the local businesses who back the Cobras. Please support the people who support community football.
			</p>

			<div class="mt-6 grid gap-4 md:grid-cols-3">
				<div class="card">
					<a href="https://www.ftbbq.com.au/" target="_blank" rel="noreferrer" class="block">
						<img
							src={withBase('/assets/sponsors/oCWac0FPmXKJOLivc5O5jeJMmNwy57mL.png')}
							alt="F.T. BBQ logo"
							class="h-28 w-auto"
							loading="lazy"
							decoding="async"
						/>
						<h3 class="mt-4 text-base font-medium text-slate-900">F.T. BBQ</h3>
						<p class="mt-2 text-sm text-slate-700">The best products and advice for all things BBQ from an award winning team.</p>
						<p class="mt-3 text-sm text-slate-700">Thanks for your continued support of Metford Cobras FC &#8212; it helps keep football affordable and our match days running.</p>
						<span class="mt-4 inline-block text-sm font-medium text-cobra-blue">Visit website &#8594;</span>
					</a>
				</div>

				<div class="card">
					<a href="https://www.swirlndip.com.au/" target="_blank" rel="noreferrer" class="block">
						<img
							src={withBase('/assets/sponsors/swirl.png')}
							alt="Swirl n Dip logo"
							class="h-28 w-auto"
							loading="lazy"
							decoding="async"
						/>
						<h3 class="mt-4 text-base font-medium text-slate-900">Swirl n Dip</h3>
						<p class="mt-2 text-sm text-slate-700">An intergalactic taste sensation &#8212; perfect for celebrating wins (and shaking off tough losses).</p>
						<p class="mt-3 text-sm text-slate-700">We appreciate your continued support of the club and the community we&#8217;re building.</p>
						<span class="mt-4 inline-block text-sm font-medium text-cobra-blue">Visit website &#8594;</span>
					</a>
				</div>

				<div class="card">
					<a href="https://thewindsorcastle.com.au/" target="_blank" rel="noreferrer" class="block">
						<img
							src={withBase('/assets/sponsors/windsor-logo.png')}
							alt="The Windsor Castle logo"
							class="h-28 w-auto"
							loading="lazy"
							decoding="async"
						/>
						<h3 class="mt-4 text-base font-medium text-slate-900">The Windsor Castle</h3>
						<p class="mt-2 text-sm text-slate-700">A classic local venue for meals, catch-ups, and community get-togethers.</p>
						<p class="mt-3 text-sm text-slate-700">Thank you for your continued support &#8212; your backing makes a real difference for players and families.</p>
						<span class="mt-4 inline-block text-sm font-medium text-cobra-blue">Visit website &#8594;</span>
					</a>
				</div>
			</div>
		</div>

		<div class="mt-10 grid gap-4 md:grid-cols-3">
			<div class="card">
				<h2 class="text-base font-medium text-slate-900">Community impact</h2>
				<p class="mt-2 text-sm text-slate-700">Help keep football accessible and build a strong local club.</p>
			</div>
			<div class="card">
				<h2 class="text-base font-medium text-slate-900">Brand exposure</h2>
				<p class="mt-2 text-sm text-slate-700">Reach families and locals through game days, signage and socials.</p>
			</div>
			<div class="card">
				<h2 class="text-base font-medium text-slate-900">Easy to support</h2>
				<p class="mt-2 text-sm text-slate-700">Simple tiers and clear deliverables. We&#8217;ll look after you.</p>
			</div>
		</div>

		<div id="tiers" class="mt-10">
			<h2 class="text-xl font-medium text-slate-900">Sponsorship tiers</h2>
			<p class="mt-2 text-sm text-slate-700">Options for businesses of every size and budget.</p>

			<div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
				{tiers.map((tier) => (
					<div class:list={[
						'card flex flex-col',
						tier.premium ? 'bg-cobra-blue ring-0' : '',
						tier.wide ? 'md:col-span-2' : '',
					]}>
						<div class="flex items-start justify-between gap-4">
							<div class="flex-1 min-w-0">
								<p class:list={['text-xs font-medium uppercase tracking-wider', tier.premium ? 'text-cobra-yellow' : 'text-cobra-blue']}>
									{tier.tagline}
								</p>
								<h3 class:list={['mt-0.5 text-base font-semibold', tier.premium ? 'text-white' : 'text-slate-900']}>
									{tier.name} Sponsorship
								</h3>
							</div>
							<span class:list={[
								'shrink-0 rounded-full px-3 py-1 text-sm font-semibold',
								tier.premium ? 'bg-cobra-yellow/20 text-cobra-yellow' : 'bg-cobra-blue/10 text-cobra-blue',
							]}>
								{tier.price}
							</span>
						</div>

						<ul class="mt-3 space-y-1.5">
							{tier.benefits.map((benefit) => (
								<li class:list={['flex gap-2 text-sm', tier.premium ? 'text-white/80' : 'text-slate-700']}>
									<span class:list={['mt-0.5 shrink-0 font-bold', tier.premium ? 'text-cobra-yellow' : 'text-cobra-yellow']} aria-hidden="true">&#8212;</span>
									{benefit}
								</li>
							))}
						</ul>

						{tier.jerseyImage && (
							<img
								src={withBase(tier.jerseyImage)}
								alt={tier.jerseyImageAlt}
								class="mt-4 w-full rounded-xl object-cover"
								loading="lazy"
								decoding="async"
							/>
						)}

						<div class="mt-4 flex flex-wrap items-center gap-3">
							<a class="btn-accent" href={withBase('/contact-us')}>
								Enquire &#8594;
							</a>
						</div>
					</div>
				))}
			</div>
		</div>

		<div class="mt-8 rounded-2xl bg-cobra-yellow p-5">
			<p class="kicker">Refer a sponsor</p>
			<h2 class="mt-2 text-lg font-medium text-cobra-blue">Know a local business?</h2>
			<p class="mt-2 text-sm text-cobra-blue/80">
				Refer a sponsor and earn free rego for the season &#8212; worth up to $350. Any Cobras player or parent can take part.
			</p>
			<a class="mt-4 btn-primary" href={withBase('/sponsorship/how-to-ask')}>
				How to refer a sponsor &#8594;
			</a>
		</div>

		<div class="mt-6 rounded-2xl bg-cobra-blue/5 p-5">
			<h3 class="text-base font-medium text-slate-900">Ready to get involved?</h3>
			<p class="mt-1 text-sm text-slate-700">Get in touch and we&#8217;ll work with you to find the right fit. We&#8217;re always happy to discuss arrangements that work for both parties.</p>
			<div class="mt-4 flex flex-wrap gap-3">
				<a class="btn-primary" href={withBase('/contact-us')}>Contact Us</a>
				<a class="btn-secondary" href="mailto:metfordcobrasfootballclub@gmail.com">metfordcobrasfootballclub@gmail.com</a>
			</div>
		</div>
	</section>
</BaseLayout>
